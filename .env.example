# 数据库
POSTGRES_USER=reval
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=reval
DATABASE_URL=postgresql+psycopg://reval:change_me_strong_password@db:5432/reval

# JWT
JWT_SECRET=change_me_random_64_chars
JWT_ACCESS_EXPIRE_MINUTES=30
JWT_REFRESH_EXPIRE_DAYS=7

# 应用
APP_ENV=production
FIRST_ADMIN_PHONE=13800000000
FIRST_ADMIN_PASSWORD=change_me_admin_password

# 站点域名（Caddy 自动 HTTPS；本地/无域名可留空或 localhost）
DOMAIN=your-domain.com
